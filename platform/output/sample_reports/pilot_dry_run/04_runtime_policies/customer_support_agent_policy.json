{
  "schema_version": "aegis.policy/v1",
  "policy_id": "pol-customer-support-agent",
  "policy_name": "Customer support agent — Runtime Policy",
  "description": "Draft runtime policy generated by AEGIS for Customer support agent (Answer customer queries and update tickets using CRM data). Overall runtime risk: High (Inferred). Review before rollout.",
  "version": "0.1.0",
  "status": "draft",
  "owner": "AI System Owner",
  "applies_to": {
    "agent_name": [
      "customer-support-agent"
    ],
    "environment": [
      "production"
    ],
    "risk_tier": [
      "High"
    ],
    "tenant": [
      "*"
    ],
    "model": [
      "*"
    ]
  },
  "rollout": {
    "mode": "observe",
    "exit_criteria": [
      "At least 5,000 representative requests evaluated",
      "Would-be decision distribution reviewed by the system owner and security",
      "Sampled would-be blocks reviewed; false-positive rate < 3%",
      "Every legitimate tool seen in traffic has an explicit rule (no legitimate default-deny hits)",
      "Limits calibrated from observed peaks"
    ],
    "notes": "Each promotion is a new policy version that goes draft → in_review → approved → active with recorded human approval. AEGIS never promotes or activates a policy on its own."
  },
  "identity": {
    "required": true,
    "required_claims": [
      "sub",
      "tenant_id",
      "roles"
    ],
    "allowed_roles": [],
    "tenant_binding": true
  },
  "tools": {
    "default_action": "DENY",
    "deny_list": [],
    "rules": [
      {
        "id": "tool.crm-read",
        "tool": "crm_read",
        "operation": "read",
        "action": "ALLOW",
        "description": "read access to personal data: restrict to tenant- and record-scoped queries",
        "scopes": [
          "crm-read:read"
        ],
        "parameters": {},
        "additional_parameters": true,
        "citations": [
          "IS-11",
          "EI-07"
        ]
      },
      {
        "id": "tool.crm-write",
        "tool": "crm_write",
        "operation": "write",
        "action": "REQUIRE_HUMAN_APPROVAL",
        "description": "state-changing action in a high-risk context with no declared parameters to validate",
        "scopes": [
          "crm-write:write"
        ],
        "parameters": {},
        "additional_parameters": true,
        "citations": [
          "IS-11",
          "IS-12",
          "EI-07"
        ],
        "approval_roles": [
          "Business Owner"
        ],
        "max_calls_per_session": 20
      },
      {
        "id": "tool.send-email",
        "tool": "send_email",
        "operation": "external_send",
        "action": "REQUIRE_HUMAN_APPROVAL",
        "description": "external communication leaves the organization: human approval before sending",
        "scopes": [
          "send-email:external_send"
        ],
        "parameters": {},
        "additional_parameters": true,
        "citations": [
          "IS-11",
          "IS-13",
          "IS-04",
          "EI-07"
        ],
        "approval_roles": [
          "Business Owner"
        ],
        "max_calls_per_session": 10,
        "allow_pii_entities": [
          "email"
        ]
      }
    ]
  },
  "content": {
    "max_input_chars": 16000,
    "pii_redaction": {
      "enabled": true,
      "entities": [
        "email",
        "phone",
        "payment_card",
        "iban",
        "us_ssn",
        "uk_nino",
        "india_pan",
        "india_aadhaar",
        "ip_address",
        "api_key"
      ],
      "apply_to": [
        "prompt",
        "response",
        "tool_params",
        "tool_output"
      ],
      "action": "REDACT"
    },
    "prompt_injection": {
      "enabled": true,
      "apply_to": [
        "prompt",
        "tool_output",
        "tool_params"
      ],
      "action": "DENY",
      "decode_obfuscation": true
    },
    "jailbreak": {
      "enabled": true,
      "apply_to": [
        "prompt"
      ],
      "action": "DENY",
      "decode_obfuscation": true
    },
    "transforms": [
      {
        "id": "transform.truncate_response",
        "type": "truncate",
        "apply_to": [
          "response"
        ],
        "max_chars": 16000
      },
      {
        "id": "transform.ai_disclosure",
        "type": "append_disclosure",
        "apply_to": [
          "response"
        ],
        "text": "This response was generated with AI assistance."
      }
    ]
  },
  "limits": {
    "requests_per_minute": 30,
    "tool_calls_per_session": 20,
    "tokens_per_day": 500000,
    "cost_per_month_usd": 3000,
    "action_on_breach": "RATE_LIMIT",
    "alert_at_percent": 80
  },
  "logging": {
    "immutable_audit": true,
    "prompt_logging": "redacted",
    "response_logging": "redacted",
    "tool_param_logging": "redacted",
    "sink": "aegis_common.audit.AuditLog (hash-chained JSONL); ship to WORM storage in production"
  },
  "kill_switch": {
    "enabled": true,
    "engaged": false,
    "scopes": [
      "agent",
      "tool",
      "model",
      "tenant"
    ],
    "engaged_targets": [],
    "authorized_roles": [
      "Security Operations Lead",
      "AI System Owner",
      "SRE On-call"
    ],
    "target_time_to_disable_minutes": 5
  },
  "rollback": {
    "previous_version": null,
    "strategy": "disable",
    "triggers": [
      "Injection detected in a prompt or tool output that reached a tool call",
      "Sensitive data observed in a response, outbound message or log",
      "Unauthorized or anomalous tool call (default-deny spike, scope violation, parameter violations)",
      "Rate/budget limit breaches or loop behaviour",
      "Model vendor outage, unannounced model change or vendor security incident"
    ]
  },
  "shadow_mode": {
    "enabled": true,
    "evaluate_as": "enforce"
  },
  "evidence_retention_days": 730,
  "approval": {
    "required_approver_roles": [
